{
  "name": "hive-react-coding-challenge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "webpack serve --progress",
    "build": "webpack --env=prod",
    "lint": "eslint --fix --ext .js,.jsx,.ts,.tsx src"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
